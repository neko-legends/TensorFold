diff --git i/src/tensorfold/families/deepseek_v41/cuda/logprobs.py w/src/tensorfold/families/deepseek_v41/cuda/logprobs.py
new file mode 100644
index 0000000..a513a59
--- /dev/null
+++ w/src/tensorfold/families/deepseek_v41/cuda/logprobs.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The whole vocabulary's log-softmax at TP=4 (and TP=1/2): each rank's log-sum-exp parts, one gather, rank 0's rows.
+
+At TP>1 a rank's head holds only its own vocabulary slice -- the uneven whole-128-block split
+(32,384 / 32,384 / 32,256 / 32,256 of 129,280) -- so the normalizer of the full distribution sits on no single rank.
+Each rank reduces its slice to a ``(max, sum of exp(x - max))`` pair a row (the same reduction
+``tensorfold.cuda.logprobs._parts`` runs over one rank's full row), the pairs travel beside the candidates in the
+verify window's all-gather (two extra floats a row, only when a request asks for probabilities), and every rank
+combines them in rank order into ``lse = max + log(sum)``.
+
+The per-token log probabilities then come from the same bf16-valued fp32 logits the sampler reads
+(``pick.kit_logits``: the forward rounds the head to bf16, and vLLM's greedy sampler takes the argmax of those):
+``logprob(t) = logit(t) - lse``, the top-``N`` columns of the merged candidates with the same subtraction. Nothing
+here changes a value the sampler sees; the uneven split cannot change a log probability because the reduction only
+adds the parts, and ``tests/test_dsv41_logprobs.py`` checks that against one rank's own full-row log-softmax.
+
+Where it is used (the serving batcher only; the one-slot path refuses ``logprobs``):
+``slots.SlotsForward.cand_gather`` computes the parts and the combined ``lse``, ``Candidates.lse`` carries it to
+``batch.Batcher._sample``, which fills the request's ``tensorfold.engine.probabilities.Probabilities`` collector.
+Drafted rows are no exception: the logits are the verify pass's (the model that accepted the token), never a
+drafter's own logits -- ``window`` reads the target's rows, and the drafter's proposals never reach this module.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import numpy as np
+import torch
+
+__all__ = ["chosen_values", "combine", "parts", "record", "top_rows"]
+
+
+def parts(lg: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """A rank's logits [R, C] (any float dtype) -> per-row (max, sum of exp(x - max)) fp32 [R] each.
+
+    A row with no finite column (fully masked; impossible for a live grammar) reduces to (-inf, 0), as the kit's
+    Triton kernel does, so the combination stays finite-or-zero instead of NaN.
+    """
+
+    mx = lg.max(dim=1).values.to(torch.float32)
+    base = torch.where(torch.isfinite(mx), mx, torch.zeros_like(mx))
+    sm = torch.exp(lg.to(torch.float32) - base[:, None]).sum(dim=1, dtype=torch.float32)
+    return mx, sm
+
+
+def combine(mx: torch.Tensor, sm: torch.Tensor) -> torch.Tensor:
+    """The ranks' parts ([W, R] each, rank order) -> the whole vocabulary's log-sum-exp [R] fp32.
+
+    ``max`` over the ranks' maxima, then the sums scaled to it: the sum is taken in rank order, so every rank that
+    runs this (rank 0 and rank 1 alike) gets the same bits from the same gathered parts.
+    """
+
+    best = mx.max(dim=0).values
+    base = torch.where(torch.isfinite(best), best, torch.zeros_like(best))
+    total = (sm.to(torch.float32) * torch.exp(mx.to(torch.float32) - base[None, :])).sum(dim=0)
+    return base + torch.log(total)
+
+
+def chosen_values(values: np.ndarray, ids: np.ndarray, chosen: Sequence[int]) -> np.ndarray:
+    """Each row's logit for the token the sampler chose (float32 [n]): the merged candidates hold it, because
+    ``batch.Batcher._choose`` picks from them (greedy column 0, sampled / nucleus their kept set)."""
+
+    if len(chosen) > values.shape[0]:
+        raise ValueError(f"{len(chosen)} chosen tokens for {values.shape[0]} candidate rows")
+    out = np.empty(len(chosen), dtype=np.float32)
+    for i, token in enumerate(chosen):
+        at = np.flatnonzero(ids[i] == int(token))
+        if not len(at):
+            raise RuntimeError(f"the chosen token {int(token)} is not among row {i}'s candidates")
+        out[i] = values[i, at[0]]
+    return out
+
+
+def top_rows(values: np.ndarray, ids: np.ndarray, lse: np.ndarray, count: int) -> tuple[list[list[int]],
+                                                                                       list[list[float]]]:
+    """The best ``count`` candidates a row as (token ids, log probabilities): the merged candidates are already in
+    OpenAI's ``top_logprobs`` order (value descending, ties to the lower id), and a column the window masked or the
+    gather padded (``-inf``) is left out rather than reported as a probability of zero."""
+
+    top_ids: list[list[int]] = []
+    top_values: list[list[float]] = []
+    for i in range(values.shape[0]):
+        row_values, row_ids = values[i], ids[i]
+        keep = int(min(count, row_values.shape[0]))
+        finite = np.flatnonzero(np.isfinite(row_values[:keep]))
+        top_ids.append([int(row_ids[j]) for j in finite])
+        top_values.append([float(row_values[j] - lse[i]) for j in finite])
+    return top_ids, top_values
+
+
+def record(probabilities, positions: Sequence[int], out: Sequence[int], chosen: Sequence[int],
+           cand) -> None:
+    """``batch.Batcher._sample``: this window's emitted rows into the request's collector.
+
+    ``out`` is the accepted prefix the round emits (``chosen[:acc + 1]``, then cut at an EOS or ``max_tokens``), so
+    it maps to candidate rows 0..len(out)-1 and to positions ``positions`` likewise. The logits are the verify
+    pass's -- the target's own rows -- never the drafter's: a drafted token's row is the one that accepted it.
+    """
+
+    n = len(out)
+    if n == 0:
+        return
+    if cand.lse is None:
+        raise RuntimeError("the window has no log-sum-exp (the plan did not ask the ranks' parts)")
+    values, ids, lse = cand.values[:n], cand.ids[:n], cand.lse[:n]
+    logprobs = chosen_values(values, ids, list(out)) - lse
+    top_ids, top_values = top_rows(values, ids, lse, int(probabilities.top))
+    probabilities.add(list(positions[:n]), [int(t) for t in out], logprobs.tolist(), top_ids, top_values)
