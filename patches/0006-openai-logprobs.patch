+def test_batcher_reports_the_verify_rows_log_probs(topo):
+    from test_dsv41_serving_batch import run
+
+    b = serving_batcher(topo, n=1)
+    fwd = b.fwd
+    prompt = [int(t) for t in np.random.default_rng(5).integers(2, VOCAB, size=60)]
+    probs = Probabilities(5, len(prompt), 12)
+    toks = run(b, [Job(list(prompt), 8, None, probabilities=probs)])[0]
+    assert 1 <= len(toks) <= 8 and fwd.win_probs == [1]
+    rows = probs.emitted(toks)                       # ids match the emitted tokens, positions start at len(prompt)
+    assert sorted(probs.rows) == list(range(len(prompt), len(prompt) + len(toks)))
+    for i, row in enumerate(rows):
+        v = fwd.rows_full[(0, len(prompt) + i)]
+        ref = v.astype(np.float64) - np.logaddexp.reduce(v.astype(np.float64))
+        assert row["logprob"] == pytest.approx(float(ref[row["id"]]), abs=1e-4)
+        top_ids = [t for t, _ in row["top"]]
+        top_lp = [p for _, p in row["top"]]
+        want_ids = np.lexsort((np.arange(VOCAB), -v))[:5]
+        assert top_ids == [int(t) for t in want_ids]
+        assert top_lp == pytest.approx([float(ref[t]) for t in want_ids], abs=1e-4)
+        assert top_ids[0] == row["id"] and len(row["top"]) == 5                 # greedy: the chosen is the top one
