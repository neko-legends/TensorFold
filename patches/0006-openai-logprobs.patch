+def test_four_rank_log_softmax_matches_one_rank(ck4):
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+
+    def go(r):
+        f = DF.forward(ck4, rank=r, world=4, comm=comms[r], dspark=False)
+        lg = f.run([Seg(0, 0, tuple(PROMPT))])
+        return f.candidates(lg, [len(PROMPT)], 24, None, [1] * len(PROMPT))
+
+    with N.exact():
+        got = pair.run([lambda r=r: go(r) for r in range(4)])
+        one = DF.forward(ck4, dspark=False)
+        lg1 = one.run([Seg(0, 0, tuple(PROMPT))])
+        plain = one.candidates(lg1, [len(PROMPT)], 24)
+    assert plain.lse is None                                                  # not asked: no normalizer
+    want = torch.logsumexp(lg1.float(), dim=1).numpy()
+    for c in got:
+        assert c.lse is not None and c.lse.shape == (len(PROMPT),)
+        assert np.allclose(c.lse, want, rtol=1e-5, atol=1e-5)
+    for r in range(1, 4):                                                     # the combination is rank-order exact
+        assert np.array_equal(got[r].lse, got[0].lse)
+    logprobs = got[0].values - got[0].lse[:, None]
+    assert np.all(np.diff(logprobs, axis=1) <= 1e-6)                          # the order the sampler reads
+    assert np.exp(logprobs[:, :24].astype(np.float64)).sum(axis=1).max() <= 1.0
