+def test_the_app_reply_carries_openai_logprobs(prob_app):
+    app, _b, fwd = prob_app
+    body = {**BODY, "logprobs": True, "top_logprobs": 4}
+    assert app.check(dict(body)) is None                          # the request is accepted as it stands
+    res = app.run(dict(body), True, lambda delta: True)
+    content = res["logprobs"]["content"]
+    ids = res["stats"]["token_ids"]
+    assert len(content) == len([t for t in ids if t != 1])        # the EOS itself is not an item (OpenAI)
+    at = 0
+    for pos, token in enumerate(ids):
+        if token == 1:
+            continue
+        entry = content[at]
+        at += 1
+        assert set(entry) == {"token", "bytes", "logprob", "top_logprobs"}
+        v = fwd.rows_full[(0, res["prompt_tokens"] + pos)]       # the verify row that produced this token
+        ref = v.astype(np.float64) - np.logaddexp.reduce(v.astype(np.float64))
+        assert entry["logprob"] == pytest.approx(float(ref[token]), abs=1e-4)
+        tops = entry["top_logprobs"]
+        want = np.lexsort((np.arange(VOCAB), -v))[:4]
+        assert len(tops) == 4 and all(set(t) == {"token", "bytes", "logprob"} for t in tops)
+        assert [t["logprob"] for t in tops] == pytest.approx([float(ref[t]) for t in want], abs=1e-4)
+        assert tops[0]["logprob"] == entry["logprob"]            # greedy: the emitted token is the top one
+
