# The cluster and paths for DeepSeek-V4.1-Flash-1017 on four Sparks. Copy to deploy/dsv41-1017/sparks.env (git-ignored
# name pattern: keep your hostnames out of commits) and fill in every <placeholder>. Read by download.sh, fanout.sh,
# engram-pack.sh and serve-1017.sh, all run on rank 0's node. Every path is the same on all four nodes.

# ssh targets of ranks 1, 2, 3, in rank order (user@host or ~/.ssh/config names; over the CX7 link is fastest).
# Rank 0 is the node these scripts run on. Passwordless ssh from rank 0 to each is required.
WORKERS="<rank1-host> <rank2-host> <rank3-host>"

# this repository, checked out at the same path on every node (run-zig.sh runs from it on each rank)
REPO_DIR="<path>/tensorfold-4x-sparks"

# the served weights: LibertAIDAI/DeepSeek-V4.1-Flash-1017-EXL3-2.9bpw (~211 GB), on all four nodes
MODEL_DIR="<path>/models/DeepSeek-V4.1-Flash-1017-EXL3-2.9bpw"
# the Engram source: deepseek-ai/DeepSeek-V4.1-Flash-1017, only shards 47/48 + index + config (~203 GB), rank 0 only
FP8_DIR="<path>/models/DeepSeek-V4.1-Flash-1017"

# weight-derived dirs, kept apart from any earlier pack's (an earlier pack's Engram tables, bias and prepared
# folders do NOT match the 1017 weights)
ENGRAM_DIR="<path>/dsv41-1017-engram-w4"          # engram-l{1,14}-r<rank>of4.bin, ~48 GB a node
ASSETS_ROOT="<path>/zigtp4-1017-assets"           # rank-0 .. rank-3: rope.bin, engram-host.bin, aot/
PREPARED_DIR="<path>/zigtp4-1017-prepared"        # written by the first boot, ~80 GB a node
STATE_DIR="<path>/zigtp4-1017-state"              # request log, sessions, calibration
CACHE_DIR="<path>/zigtp4-1017-cache"              # pfdense-table.json + dsv41-bias-vl/bias_vl.safetensors

# the engine config each rank reads (CONFIG= for scripts/run-zig.sh), same path on every node
ENV_FILE="$REPO_DIR/deploy/dsv41-1017/zig-1017.env"

# a Docker image with python3 + numpy for scripts/pack_engram.py (CPU only); empty = the host's python3
PY_IMAGE=""

# serving
PORT=8000
ALIAS=""                     # optional second model id on /v1/models (e.g. deepseek-v4.1-flash for old clients)
READY_TIMEOUT=2400           # seconds; the first boot writes the prepared folders (405 s measured), later boots ~35 s
LOGDIR="$STATE_DIR/logs"
HF="hf"                      # the huggingface_hub CLI
