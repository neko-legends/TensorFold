+# -- the reduction over uneven slices ----------------------------------------------------------------------------------
+def test_parts_and_combine_match_one_ranks_logsumexp():
+    """Every rank's slice reduced, then combined: the whole vocabulary's log-softmax, mass 1, uneven widths."""
+
+    V, W = 640, 4
+    g = torch.Generator().manual_seed(11)
+    lg = torch.randn((5, V), generator=g).to(torch.bfloat16).float()
+    assert [hi - lo for lo, hi in slices(V, W)] == [256, 128, 128, 128]      # uneven: 5 whole 128-blocks
+    lg[1, 300:400] = float("-inf")                                           # a masked stretch
+    lg[3, :] = float("-inf")
+    lg[3, 5] = 2.5                                                           # one live column a row
+    assert lg[3].max().item() == 2.5
+    mx, sm = [], []
+    for lo, hi in slices(V, W):
+        a, b = LP.parts(lg[:, lo:hi])
+        mx.append(a)
+        sm.append(b)
+    lse = LP.combine(torch.stack(mx), torch.stack(sm))
+    want = torch.logsumexp(lg, dim=1)
+    assert torch.allclose(lse, want, rtol=1e-5, atol=1e-5)
+    assert float(lse[3]) == pytest.approx(2.5, abs=1e-6)
+    mass = torch.exp(lg - lse[:, None]).sum(dim=1)                           # sums to 1 over the whole vocabulary
+    assert torch.allclose(mass, torch.ones(5), rtol=1e-5, atol=1e-5)
+
