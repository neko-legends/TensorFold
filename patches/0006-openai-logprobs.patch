+def test_one_rank_parts_are_the_reference():
+    """A single rank (world 1) is the same path: its own full row's parts combine to its logsumexp."""
+
+    g = torch.Generator().manual_seed(3)
+    lg = torch.randn((4, 300), generator=g).float()
+    mx, sm = LP.parts(lg)
+    assert torch.allclose(LP.combine(mx[None], sm[None]), torch.logsumexp(lg, dim=1), rtol=1e-6, atol=1e-6)
+
