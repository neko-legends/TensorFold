+# -- the app and the route (needs the V4.1 tokenizer: ``TF_DSV41_TOKENIZER_DIR``) ------------------------------------
+class _NoGrammar:
+    """A grammar host that binds nothing (logprobs refuse structured output anyway)."""
+
+    def check(self, body):
+        return None
+
+    def for_request(self, body):
+        return None
+
+    def bind(self, spec, prompt):
+        return None
