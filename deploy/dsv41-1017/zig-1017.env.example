# DeepSeek-V4.1-Flash-1017 EXL3 2.9 bpw (LibertAIDAI, rev afc7aa0a) on the Zig TP=4 engine: the engine CONFIG that
# scripts/run-zig.sh sources on each rank (serve-1017.sh passes it as CONFIG=). Copy to deploy/dsv41-1017/zig-1017.env
# on EVERY node (same path), next to a filled-in sparks.env.
#
# This is the four-Spark serving profile (config/tp4-zig.env.example, filled in as config/tp4-zig.env) with the
# settings the live service runs since 2026-10-17: the same image and engine knobs as the earlier pack, only the
# weights and their own weight-derived dirs changed. No 1017-specific engine knob exists or is needed.
source config/tp4-zig.env             # run-zig.sh runs from the repo root; fill that file in first (link, HCAs)
source deploy/dsv41-1017/sparks.env   # MODEL_DIR, ENGRAM_DIR, ASSETS_ROOT, PREPARED_DIR, STATE_DIR, CACHE_DIR, PORT

IMAGE="dsv41-tensorfold:zigtp4-<shortsha>"   # the Zig engine image (docker/zig/Dockerfile; served build: zig commit 3c5b773b or later)
TF_COMM_BACKEND=roce                         # RoCE all-gather (scripts/zig-tp4-roce-check.sh passes first)
TF_DSV41_PREFILL_PIPE=1024                   # pipelined prompt reading (docs/ZIG-PREFILL-PIPE.md); the AOT fill must be made with it set
HOST=0.0.0.0                                 # put a proxy / auth in front for a LAN
ZIG_NAME=dsv41-tf4                           # containers dsv41-tf4-r0 .. -r3 (serve-1017.sh expects this name)
ASSETS_DIR="$ASSETS_ROOT/rank-$rank"         # run-zig.sh sets $rank before it sources this file
SERVED_NAME="DeepSeek-V4.1-Flash-1017-TF"
