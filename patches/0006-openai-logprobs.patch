+class BatchEngine:
+    """What ``Dsv41Engine`` does with the serving batcher (``MiniEngine`` in the app tests, plus probabilities)."""
+
+    eos = (1,)
+
+    def __init__(self, batch, limit: int = 4000) -> None:
+        import threading
+
+        self.batch, self.limit = batch, limit
+        self.grammar_host = _NoGrammar()
+        self.request = threading.local()
+
+    @property
+    def supports_logprobs(self) -> bool:
+        return self.batch is not None
+
+    def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True, probabilities=None):
+        return self.batch.generate_request(prompt, max_tokens, sampling, on_tokens, draft, request=self.request,
+                                           host=self.grammar_host, probabilities=probabilities)
