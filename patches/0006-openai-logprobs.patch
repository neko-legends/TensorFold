+def test_the_route_returns_them_and_refuses_a_stream(prob_app):
+    import json
+    import threading
+    import urllib.error
+    import urllib.request
+    from http.server import ThreadingHTTPServer
+
+    from tensorfold.families.glm5_next.spark.server import make_handler
+
+    app, _b, _fwd = prob_app
+    srv = ThreadingHTTPServer(("127.0.0.1", 0), make_handler(app))
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+
+    def post(payload):
+        req = urllib.request.Request(f"http://127.0.0.1:{srv.server_address[1]}/v1/chat/completions",
+                                     json.dumps(payload).encode(), {"Content-Type": "application/json"})
+        try:
+            with urllib.request.urlopen(req, timeout=60) as got:
+                return got.status, json.loads(got.read())
+        except urllib.error.HTTPError as exc:
+            return exc.code, json.loads(exc.read())
+
+    try:
+        status, payload = post({"model": "dsv41", **BODY, "logprobs": True, "top_logprobs": 2})
+        assert status == 200, payload
+        choice = payload["choices"][0]
+        assert "logprobs" in choice and len(choice["logprobs"]["content"]) >= 1
+        status, payload = post({"model": "dsv41", **BODY, "logprobs": True, "stream": True})
+        assert status == 400 and "logprobs" in payload["error"]["message"]
+    finally:
+        srv.shutdown()
